# Backend Configuration ('local' for offline dev, 'supabase' for Supabase DB, 'medplum' for Medplum FHIR)
EXPO_PUBLIC_BACKEND_TYPE=supabase

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FHIR-native healthcare backend with Medplum (optional if using Medplum)
EXPO_PUBLIC_MEDPLUM_BASE_URL=https://api.medplum.com/
EXPO_PUBLIC_MEDPLUM_CLIENT_ID=
EXPO_PUBLIC_MEDPLUM_PROJECT_ID=

# LLM API Keys
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_GOOGLE_API_KEY=
