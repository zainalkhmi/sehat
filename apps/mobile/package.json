{
  "name": "future-health-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@blazejkustra/react-native-alert": "^1.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^9.0.0",
    "@medplum/core": "^4.3.6",
    "@medplum/expo-polyfills": "^4.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.8",
    "@spezivibe/account": "workspace:*",
    "@spezivibe/chat": "workspace:*",
    "@spezivibe/healthkit": "workspace:*",
    "@spezivibe/medplum": "workspace:*",
    "@spezivibe/onboarding": "workspace:*",
    "@spezivibe/questionnaire": "workspace:*",
    "@spezivibe/scheduler": "workspace:*",
    "ai": "^6.0.3",
    "expo": "^58.0.0",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "fhir": "^4.12.0",
    "formik": "^2.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.24.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.41",
    "@types/node": "^22.13.4",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-constants",
        "expo-font",
        "expo-haptics",
        "expo-image",
        "expo-linking",
        "expo-router",
        "expo-secure-store",
        "expo-splash-screen",
        "expo-status-bar",
        "expo-symbols",
        "expo-system-ui",
        "expo-web-browser",
        "react",
        "react-dom",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "@react-native-community/datetimepicker",
        "@types/react",
        "eslint-config-expo",
        "typescript"
      ]
    }
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
