# Future Health Web - Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Service Role Key (Backend / Server Actions only - NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Engine Service URL
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# FHIR Gateway Service URL
NEXT_PUBLIC_FHIR_GATEWAY_URL=http://localhost:8080/fhir

